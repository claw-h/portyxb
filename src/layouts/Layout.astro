---
import '@fontsource/architects-daughter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/unbounded';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50' fill='%237b61ff'/></svg>" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A scroll-driven creative direction portfolio built with Astro, Three.js, and canvas."
		/>
		<title>Portfolio</title>
		<script is:inline>
			const isMobileDevice = window.matchMedia('(max-width: 768px), (pointer: coarse)').matches;
			if (isMobileDevice) {
				document.documentElement.classList.add('is-mobile-gate');
				if (location.pathname !== '/mobile' && !location.pathname.startsWith('/mobile/')) {
					location.replace('/mobile');
				}
			}
		</script>
		<script is:inline>
        window.__NEURAL_STATE = {
            targetProgress: 0,
            modelsReady: false,
			fontsReady: false,
			heartRenderReady: false
        };
    </script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		background: #0a0a0c;
		font-family:
			"IBM Plex Mono", "SFMono-Regular", Consolas, "Liberation Mono", Menlo,
			monospace;
	}
		/* Hide scrollbar for Chrome, Safari, and Opera */
	::-webkit-scrollbar {
		display: none;
	}

	/* Hide scrollbar for IE, Edge, and Firefox */
	html {
		-ms-overflow-style: none;  /* IE and Edge */
		scrollbar-width: none;  /* Firefox */
	}
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #0a0a0c;
		color: #f3f0ff;
		scroll-behavior: smooth;
	}

	body {
		overflow-x: hidden;
	}

	* {
		box-sizing: border-box;
	}

	::selection {
		background: #7b61ff;
		color: #ffffff;
	}
</style>
