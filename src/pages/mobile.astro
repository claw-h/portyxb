---
import Layout from '../layouts/Layout.astro';
import DossierIndex from '../components/DossierIndex.astro';

import '../styles/dossier.css';
---

<Layout>
    <main class="mobile-page">
        <section class="dossier-zone" id="mobile-work">
            <div class="dossier-sticky">
                <DossierIndex />
            </div>
        </section>
    </main>
</Layout>

<style>
    .mobile-page,
    .mobile-page .dossier-zone,
    .mobile-page .dossier-sticky {
        width: 100%;
        height: 100dvh;
        min-height: 100vh;
    }

    .mobile-page .dossier-zone {
        position: relative;
        overflow: hidden;
        background: #020508;
    }

    .mobile-page .dossier-sticky {
        position: relative;
        overflow: hidden;
    }
</style>
