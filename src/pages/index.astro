---
import Layout from '../layouts/Layout.astro';	
import Preloader from '../components/Preloader.astro';

import '../styles/ui.css';

---

<Layout>
	<Preloader />

	<div id="heart-ui-layer"></div>

	<div class="lens-cursor" aria-hidden="true">
		
		<div class="lens-outer-rim"></div>
		<div class="lens-inner-ring"></div>
		<div class="lens-glass-reflection"></div>
		<div class="lens-axis-x"></div>
		<div class="lens-axis-y"></div>

		<div class="dome-base"></div>
		<div class="dome-glass-glare"></div>
		<div class="dome-crosshair-x"></div>
		<div class="dome-crosshair-y"></div>
		
		<svg class="dome-text-ring" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
			<path id="text-path" d="M 50, 8 A 42,42 0 1,1 49.9, 8" fill="none" />
			<text fill="#8fdcff" font-size="8.5" font-family="monospace" letter-spacing="2">
				<textPath href="#text-path" startOffset="25%" text-anchor="middle">(LOCKED ON HEART)</textPath>
			</text>
			<text fill="#ffffff" font-size="8.5" font-family="monospace" letter-spacing="2">
				<textPath href="#text-path" startOffset="75%" text-anchor="middle">TARGET <tspan id="cursor-coords">(0, 0)</tspan></textPath>
			</text>
		</svg>

		<div class="lens-focal-point" id="focal-char">A</div>
		
	</div>
	<main class="site-shell">

		<!-- ═══════════════════════════════════════════
		     ZONE 01 — HEART SEQUENCE (scroll-driven)
		════════════════════════════════════════════ -->
		<section class="hero-sequence" id="hero" data-hero>
			<div class="hero-sticky">
				<canvas class="heart-canvas" data-heart-canvas></canvas>
				<canvas class="fire-canvas"  data-fire-canvas></canvas>
				<canvas class="ink-canvas"   data-ink-canvas></canvas>
				<div class="scroll-prompt" data-scroll-prompt>scroll to explore</div>
				<div class="hero-copy" data-hero-copy>
					<p class="hero-copy-line hero-copy-line--one">This is where it opens.</p>
					<p class="hero-copy-line hero-copy-line--two">Come in.</p>
				</div>


			</div>
			<div class="hero-progress" aria-hidden="true">
				<span data-hero-progress></span>
			</div>
			<svg class="hero-border-svg" aria-hidden="true">
				<defs>
					<linearGradient id="hero-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="#8fdcff" />
						<stop offset="100%" stop-color="#4da2ff" />
					</linearGradient>
				</defs>
				
				<path class="hero-border-path" />
				<path class="hero-border-path" />
			</svg>
		</section>

		<!-- ═══════════════════════════════════════════
		     ZONE 02 — DREAM CANVAS
		════════════════════════════════════════════ -->
		<section class="dream-zone canvas-zone" data-canvas-zone="dream">
			<canvas data-dream-canvas></canvas>
			<!-- No DOM copy — declaration is rendered character-by-character via pretext onto canvas -->
		</section>

		<!-- ═══════════════════════════════════════════
			ZONE 03 — BIOME SPHERE (Works)
		════════════════════════════════════════════ -->
		<section class="biome-zone canvas-zone" id="work" data-canvas-zone="biome">
			<div class="biome-sticky">
				<canvas class="biome-canvas" data-biome-canvas></canvas>
				
				<!-- The UI layer for our sci-fi telemetry system -->
				<div id="biome-ui-layer" class="biome-ui-container"></div>
				
				<!-- Subtle gradient overlay to blend the sphere edges into the void -->
				<div class="biome-vignette" aria-hidden="true"></div>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════
		     ZONE 04 — VOID CANVAS / CRT TV
		════════════════════════════════════════════ -->
		<section class="void-zone canvas-zone" data-canvas-zone="void">
			<div class="void-tv">
				<div class="void-shell">
					<div class="void-shell__screen">
						<canvas data-void-canvas></canvas>
						<div class="void-shell__glass"></div>
						<div class="void-shell__glare"></div>
						<div class="void-spotlight" aria-hidden="true"></div>
						<div class="void-copy-panel">
							<div class="void-copy-content">
								<p class="eyebrow">ZONE 04 / AFTERIMAGE</p>
								<h2>The frame keeps moving after the cut.</h2>
								<p>
									A darker room of particles, light leaks, and drifting fragments.
									Move through it and the field bends around you.
								</p>
							</div>
						</div>
					</div>
					<div class="void-shell__badge">YXB</div>
					<div class="void-shell__antenna" aria-hidden="true"></div>
					<div class="void-shell__grille"></div>
					<div class="void-controls" aria-hidden="true">
						<div class="void-knob void-knob--large"></div>
						<div class="void-knob void-knob--small"></div>
						<div class="void-button"></div>
					</div>
					<div class="void-speaker" aria-hidden="true"></div>
				</div>
				<div class="void-legs" aria-hidden="true">
					<span></span><span></span>
				</div>
			</div>
		</section>

	</main>
</Layout>

<!-- ═══════════════════════════════════════════
     JS — all logic lives in typed modules.
     This block only bootstraps and wires cleanup.
════════════════════════════════════════════ -->
<script>
	import { setupCursor }         from '../controllers/CursorController';
	import { setupHeroCopyReveal } from '../controllers/ScrollReveal';
	import { onReady }             from '../utils/loadState';
	import type { LoopController } from '../utils/canvas';
	import Lenis from 'lenis';
	import { setupDreamCanvas, setDreamScrollVelocity, setDreamScrollProgress } from '../scenes/DreamCanvas';
	import { setupVoidCanvas } from '../scenes/VoidCanvas';

	let setDreamScrollVelocity: ((v: number) => void) | null = null;
	let setDreamScrollProgress: ((p: number) => void) | null = null;

	// The whole site sits fully laid out behind the (opaque) preloader from
	// first paint — this class just locks scroll so the page can't be
	// scrolled mid-load and land somewhere other than the top when the
	// preloader lifts. Removed once utils/loadState reports real readiness.
	document.documentElement.classList.add('is-site-loading');

	// Boot all systems. setupDreamCanvas is synchronous — it kicks off its
	// own async GLTF load internally and reports completion via
	// utils/loadState, but returns its controller immediately.
	const cursor     = setupCursor();
	const heroCopy   = setupHeroCopyReveal();
	let active3DScene: LoopController | null = null;
	let isInitializing = false; // Add this guard flag

	// BiomeSphere loads async (see init3DSystem below), so its scroll setter
	// isn't available until that import resolves. Lenis scroll events that
	// fire before then are harmless no-ops — we just guard the call.
	let setBiomeProgress: ((progress: number) => void) | null = null;
	const biomeZoneEl = document.querySelector<HTMLElement>('.biome-zone');

	// Section-local scroll progress: 0 at the moment .biome-zone's sticky
	// area locks in place, 1 at the moment it releases. This is deliberately
	// NOT the same as DreamCanvas's whole-page progress — .biome-zone is
	// 400vh with a 100vh sticky child, so only the middle 300vh of page
	// scroll should map to 0→1 here.
	function getBiomeSectionProgress(scrollY: number): number {
		if (!biomeZoneEl) return 0;
		const sectionTop = biomeZoneEl.offsetTop;
		const scrollableDistance = biomeZoneEl.offsetHeight - window.innerHeight;
		if (scrollableDistance <= 0) return 0;
		return Math.min(Math.max((scrollY - sectionTop) / scrollableDistance, 0), 1);
	}

	let heartSceneInit = false;
	let biomeSceneInit = false;

	document.addEventListener('DOMContentLoaded', () => {
		const biomeContainers = document.querySelectorAll('.biome-zone');
		const biomeObserver = new IntersectionObserver((entries) => {
			let isAnySceneVisible = false;
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					isAnySceneVisible = true;
					if (entry.target.classList.contains('biome-zone') && !biomeSceneInit) {
						biomeSceneInit = true;
						initBiomeScene();
					}
				}
			});
			if (isAnySceneVisible) {
				document.body.setAttribute('data-scene-active', 'true');
			} else {
				document.body.removeAttribute('data-scene-active');
			}
		}, { rootMargin: '100% 0px', threshold: 0.01 });
		biomeContainers.forEach(scene => biomeObserver.observe(scene));
	});

	async function initHeartScene() {
		if (isInitializing || active3DScene) return;
		isInitializing = true;
		try {
			const { setupHeartScene } = await import('../scenes/HeartScene');
			active3DScene = setupHeartScene();
		} catch (error) {
			console.error("Failed to load Heart scene:", error);
		} finally {
			isInitializing = false;
		}
	}
	initHeartScene();

	async function initBiomeScene() {
		try {
			const { setupBiomeSphere, setBiomeScrollProgress } = await import('../scenes/BiomeSphere');
			const biomeScene = setupBiomeSphere();
			setBiomeProgress = setBiomeScrollProgress;
			if (setBiomeProgress) {
				setBiomeProgress(getBiomeSectionProgress(window.scrollY));
			}

			const originalDestroy = (window as any).destroy || function() {};
			(window as any).destroy = () => {
				originalDestroy();
				biomeScene?.destroy();
			};
		} catch (error) {
			console.error("Failed to load Biome scene:", error);
		}
	}

	async function initDreamScene() {
		try {
			const mod = await import('../scenes/DreamCanvas');
			const dream = mod.setupDreamCanvas();
			setDreamScrollVelocity = mod.setDreamScrollVelocity;
			setDreamScrollProgress = mod.setDreamScrollProgress;
			const originalDestroy = (window as any).destroy || function() {};
			(window as any).destroy = () => { originalDestroy(); dream?.destroy(); };
		} catch (error) { console.error("Failed to load Dream scene:", error); }
	}

	async function initVoidScene() {
		try {
			const { setupVoidCanvas } = await import('../scenes/VoidCanvas');
			const void_ = setupVoidCanvas();
			const originalDestroy = (window as any).destroy || function() {};
			(window as any).destroy = () => { originalDestroy(); void_?.destroy(); };
		} catch (error) { console.error("Failed to load Void scene:", error); }
	}

	document.addEventListener('DOMContentLoaded', () => {
		let dreamInit = false;
		let voidInit = false;
		const lazyObserver = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					if (entry.target.classList.contains('dream-zone') && !dreamInit) {
						dreamInit = true;
						initDreamScene();
					}
					if (entry.target.classList.contains('void-zone') && !voidInit) {
						voidInit = true;
						initVoidScene();
					}
				}
			});
		}, { rootMargin: '100% 0px', threshold: 0.01 });

		const dreamEl = document.querySelector('.dream-zone');
		const voidEl = document.querySelector('.void-zone');
		if (dreamEl) lazyObserver.observe(dreamEl);
		if (voidEl) lazyObserver.observe(voidEl);
	});

	// 2. Initialize Lenis to prevent scrolling too fast
    const lenis = new Lenis({
        lerp: 0.08,             // Smoothness (lower = softer/slower catching up)
        wheelMultiplier: 0.4,   // <-- REDUCE THIS (e.g., 0.4) to limit scroll speed per flick
        smoothWheel: true,
    });



	// Held until the site is actually ready — see onReady() below.
	lenis.stop();

	// 3. Feed real-time Lenis scroll velocity into DreamCanvas
	lenis.on('scroll', (e: { velocity: number; progress: number; scroll: number; }) => {
		setDreamScrollVelocity?.(e.velocity);
		setDreamScrollProgress?.(e.progress); 

		setBiomeProgress?.(getBiomeSectionProgress(e.scroll));
	});

    // 4. Mount Lenis to the browser's requestAnimationFrame
    function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

	// ─── THE NEW SCROLL LOCK LOGIC ──────────────────────────────

	// 1. Lock the scroll when the flash sequence begins
	window.addEventListener('biome-flash-start', () => {
		lenis.stop(); // Physically prevents the user from scrolling further
	});

	// 2. Unlock the scroll when the 10 rotations finish
	window.addEventListener('biome-flash-complete', () => {
		lenis.start(); // Restores scroll functionality
	});

	// Everything above has been rendering, off-screen, behind the opaque
	// preloader this whole time. Only once fonts + the heart scene + the
	// dream/staircase scene have all genuinely finished (see
	// src/utils/loadState.ts, which Preloader.astro is also subscribed to)
	// do we unlock scroll and let the site actually be interacted with.
	onReady(() => {
		document.documentElement.classList.remove('is-site-loading');
		lenis.start();
	});

	// Unified cleanup for view transitions / HMR
	const destroy = (): void => {
		active3DScene?.destroy();
		dream?.destroy();
		void_?.destroy();
		cursor?.destroy();
		heroCopy?.();
        lenis.destroy(); // <-- 5. Clean up Lenis on page swap
	};

	document.addEventListener('astro:before-swap', destroy, { once: true });
</script>

<style>
	/* ─── Global overrides ───────────────────────────── */
	:global(body) { cursor: auto; }
	:global(.has-custom-cursor body),
	:global(.has-custom-cursor a) { cursor: none; }

	/* The site renders fully behind the opaque preloader while this class is
	   present — this is just a scroll-lock backstop alongside lenis.stop()
	   in the script above, so a wheel/touch event can't sneak past Lenis
	   and leave the page scrolled when the preloader lifts. */
	:global(html.is-site-loading) { overflow: hidden; height: 100%; }

	/* ─── Shell & scanline overlay ───────────────────── */
	.site-shell {
		position: relative;
		isolation: isolate;
		background:
			linear-gradient(rgba(77, 162, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(77, 162, 255, 0.035) 1px, transparent 1px),
			#05070b;
		background-size: 42px 42px;
	}

	.site-shell::before {
		position: fixed;
		inset: 0;
		z-index: 10;
		pointer-events: none;
		content: '';
		background: repeating-linear-gradient(
			0deg,
			rgba(255, 255, 255, 0.015),
			rgba(255, 255, 255, 0.015) 1px,
			transparent 1px,
			transparent 4px
		);
		mix-blend-mode: overlay;
		opacity: 0.25;
	}

	/* ─── Zone 01: Heart sequence ────────────────────── */
	.hero-sequence {
		height: 750vh;
    	min-height: 4125px;
		--heart-opacity: 0;
		--heart-darkness: 0;
		--hud-opacity: 0;
		position: relative;
		background:
			radial-gradient(circle at 50% 46%, rgba(77, 162, 255, calc(var(--heart-opacity) * 0.14)), transparent 38%),
			#000000;
	}

	.hero-sticky {
		position: sticky;
		top: 0;
		height: 100vh;
		overflow: hidden;
	}

	.heart-canvas,
	.fire-canvas,
	.ink-canvas,
	.canvas-zone canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.heart-canvas {
		opacity: var(--heart-opacity);
		filter: brightness(calc(1 - var(--heart-darkness) * 0.95));
		transition: opacity 180ms linear, filter 180ms linear;
	}

	.fire-canvas {
		z-index: 2;
		pointer-events: none;
		opacity: 0;
		mix-blend-mode: screen;
		transition: opacity 180ms linear;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	.ink-canvas {
		z-index: 4;
		pointer-events: none;
		mix-blend-mode: normal;
		opacity: 0;
		transition: opacity 120ms linear;
	}

	/* ─── Scroll prompt ──────────────────────────────── */
	.scroll-prompt {
		position: absolute;
		left: 50%;
		top: 82%;
		z-index: 8;
		color: rgba(220, 238, 255, 0.65);
		font-size: clamp(0.85rem, 1.8vw, 1.1rem);
		letter-spacing: 0.05rem;
		text-transform: uppercase;
		opacity: 0;
		pointer-events: none;
		transform: translateX(-50%);
		transition: opacity 620ms ease;
		text-shadow: 0 2px 8px rgba(77, 162, 255, 0.4);
	}

	.hero-sequence.is-idle:not(.has-started) .scroll-prompt {
		opacity: 1;
		animation: prompt-breathe 2.2s ease-in-out infinite;
	}

	/* ─── HUD overlay ────────────────────────────────── */
	.scan-hud {
		position: absolute;
		inset: 0;
		z-index: 4;
		pointer-events: none;
		opacity: var(--hud-opacity);
		transition: opacity 250ms cubic-bezier(0.25, 1, 0.5, 1);
	}

	/* ─── Aero glass window ──────────────────────────── */
	.aero-window {
		position: absolute;
		top: 12%;
		left: 6%;
		width: min(340px, 85vw);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 100%);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 8px;
		backdrop-filter: blur(20px) saturate(200%);
		box-shadow:
			0 12px 40px rgba(0, 0, 0, 0.5),
			inset 0 1px 1px rgba(255, 255, 255, 0.4);
		overflow: hidden;
	}

	.aero-glass-shine {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 50%;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 100%);
		pointer-events: none;
	}

	.aero-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.6rem 1rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 100%);
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.aero-title {
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.9);
		font-weight: 400;
		letter-spacing: 0.02rem;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
	}

	.aero-controls { display: flex; gap: 5px; }

	.control-btn {
		width: 14px;
		height: 14px;
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.control-btn--close {
		background: rgba(239, 68, 68, 0.4);
		border-color: rgba(239, 68, 68, 0.5);
	}

	.aero-body {
		padding: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.glass-widget { display: flex; flex-direction: column; gap: 0.4rem; }

	.widget-label {
		font-size: 0.68rem;
		color: rgba(200, 230, 255, 0.75);
		font-weight: 500;
	}

	/* ─── Gel bars ───────────────────────────────────── */
	.gel-bar {
		position: relative;
		height: 10px;
		background: rgba(0, 0, 0, 0.4);
		border-radius: 20px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		overflow: hidden;
		box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
	}

	.gel-fill {
		height: 100%;
		width: 0%;
		border-radius: 20px;
		background: linear-gradient(180deg, #a6e3ff 0%, #0088ff 45%, #0055cc 60%, #33aaff 100%);
		box-shadow: 0 0 8px rgba(0, 136, 255, 0.6);
		transition: width 100ms ease-out;
	}

	/* ─── Aero side gadgets ──────────────────────────── */
	.aero-gadget {
		position: absolute;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.01) 100%);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 12px;
		backdrop-filter: blur(16px) saturate(180%);
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		box-shadow:
			0 8px 24px rgba(0, 0, 0, 0.35),
			inset 0 1px 0 rgba(255, 255, 255, 0.2);
		overflow: hidden;
	}

	.depth-readout { right: 6%; top: 14%; width: 140px; }
	.pulse-readout { right: 6%; top: 29%; width: 140px; }

	.depth-readout span,
	.pulse-readout span {
		color: rgba(180, 215, 255, 0.6);
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.02rem;
	}

	.depth-readout strong,
	.pulse-readout strong {
		color: #ffffff;
		font-size: 1.1rem;
		font-weight: 400;
		text-shadow: 0 0 10px rgba(77, 162, 255, 0.5);
	}

	/* ─── Typography ─────────────────────────────────── */
	.eyebrow,
	.section-kicker {
		margin: 0 0 1rem;
		color: #8fdcff;
		font-size: 0.72rem;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1, h2 {
		margin: 0;
		font-family: inherit;
		font-weight: 500;
		line-height: 0.96;
	}

	h1 {
		font-size: clamp(3rem, 6vw, 6.4rem);
		max-width: 8.8ch;
		text-shadow: 0 0 30px rgba(77, 162, 255, 0.32);
	}

	h2 { font-size: clamp(2.5rem, 7vw, 6.5rem); max-width: 11ch; }

	p { line-height: 1.65; }

	/* ─── Dimension lines ────────────────────────────── */
	.dimension-line {
		position: absolute;
		z-index: 6;
		width: min(25vw, 250px);
		height: 1px;
		background: linear-gradient(90deg, transparent, #4da2ff);
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms linear, transform 180ms linear;
		top: 50%;
		left: 50%;
	}

	.dimension-line::before,
	.dimension-line::after {
		position: absolute;
		top: -4px;
		width: 9px;
		height: 9px;
		border: 1px solid #4da2ff;
		content: '';
		transform: rotate(45deg);
	}

	.dimension-line::before { left: 0; }
	.dimension-line::after  { right: 0; }

	.dimension-line span {
		position: absolute;
		right: 0;
		bottom: 0.8rem;
		padding: 0.25rem 0.5rem;
		background: rgba(5, 7, 12, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 4px;
		backdrop-filter: blur(4px);
		color: #dbeeff;
		font-size: 0.78rem;
	}

	.dimension-line--aortic   { margin-top: -18vh; margin-left: 10vw; }
	.dimension-line--ventricle { margin-top: 12vh; margin-left: 8vw; }
	.dimension-line--atrium {
		margin-top: 2vh;
		margin-left: -32vw;
		background: linear-gradient(270deg, transparent, #4da2ff);
	}
	.dimension-line--atrium span { right: auto; left: 0; }

	/* ─── Narrative / progress ───────────────────────── */
	.narrative-sequence {
		position: absolute;
		inset: 0;
		z-index: 20;
		pointer-events: none;
		display: flex;
		align-items: center;
