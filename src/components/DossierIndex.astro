<!-- Global on purpose: gallery tiles are created at runtime by JS, so Astro's
     scoped-style attribute is never applied to them. -->
<style is:global>
    /* ─── Creative gallery: justified rows ───
       Each tile's flex-basis AND flex-grow are proportional to its aspect
       ratio (--ar), so every tile in a row ends up the same height and the
       row fills the full width. The tile has the image's exact aspect ratio,
       so object-fit: cover never actually crops anything. */
    .creative-grid {
        --row-h: 300px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

    /* Keeps a short last row from stretching to full width */
    .creative-grid::after {
        content: '';
        flex-grow: 1000;
    }

    .creative-item {
        --ar: 1;
        position: relative;
        flex: calc(var(--ar) * 100) 1 calc(var(--ar) * var(--row-h));
        aspect-ratio: var(--ar);
        min-width: 0;
        overflow: hidden;
        background: #020304;
        cursor: pointer;
    }

    .creative-item img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Amber frame overlay (not a border, so it can't skew the ratios) */
    .creative-item::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        box-shadow: inset 0 0 0 1px rgba(143, 220, 255, 0.12);
        transition: box-shadow 0.2s ease;
    }

    .creative-item:hover img {
        transform: scale(1.04);
    }

    .creative-item:hover::after {
        box-shadow: inset 0 0 0 2px rgba(255, 170, 0, 0.9);
    }

    @media (max-width: 600px) {
        .creative-grid { --row-h: 180px; }
    }

</style>

<script>
    import { setHoverTarget } from '../utils/hoverTargets';
    import { playClack, playRumble, playBlip, playScramble, playDataPing } from '../utils/audio';

    const toggleBtn = document.getElementById('archive-toggle');
    const closeBtn = document.getElementById('archive-close');
    const modal = document.getElementById('archive-modal');
    
    let isOpen = false;
    
    // Scramble logic
    const scrambleChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$*';
    function runScramble(element, finalString, duration = 600) {
        let start = null;
        const step = (timestamp) => {
            if (!start) start = timestamp;
            const progress = Math.min((timestamp - start) / duration, 1);
            let result = '';
            for (let i = 0; i < finalString.length; i++) {
                if (finalString[i] === ' ' || finalString[i] === '-') {
                    result += finalString[i];
                } else if (Math.random() < progress) {
                    result += finalString[i];
                } else {
                    result += scrambleChars[Math.floor(Math.random() * scrambleChars.length)];
                }
            }
            element.innerText = result;
            if (progress < 1) requestAnimationFrame(step);
            else element.innerText = finalString; 
        };
        requestAnimationFrame(step);
    }

    if (toggleBtn && closeBtn && modal) {
        document.querySelector('.dossier-wrapper')?.addEventListener('click', () => playScramble());

        // ─── ID CARD ───
        const idCard = document.getElementById('id-card');
        const idFace = document.getElementById('id-toggle');
        const idCloseBtn = document.getElementById('id-close');
        const idFrost = document.getElementById('id-frost');
        let isIdOpen = false;

        const openId = () => {
            if (!idCard || isIdOpen) return;
            if (isOpen) closeArchive();
            isIdOpen = true;
            idCard.classList.add('is-open');
            idFace?.setAttribute('aria-expanded', 'true');
            idFrost?.classList.add('is-active');
            setHoverTarget('idcard', true);
            playClack();
            playDataPing();
        };

        const closeId = () => {
            if (!idCard || !isIdOpen) return;
            isIdOpen = false;
            idCard.classList.remove('is-open');
            idFace?.setAttribute('aria-expanded', 'false');
            idFrost?.classList.remove('is-active');
            if (!idCard.matches(':hover')) setHoverTarget('idcard', false);
            playClack();
        };

        // Lens cursor: on while hovering the button, and for the whole time the card is open
        idCard?.addEventListener('mouseenter', () => setHoverTarget('idcard', true));
        idCard?.addEventListener('mouseleave', () => {
            if (!isIdOpen) setHoverTarget('idcard', false);
        });

        idFace?.addEventListener('click', openId);
        idCloseBtn?.addEventListener('click', closeId);
        idFrost?.addEventListener('click', closeId);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeId();
        });
        
        const openArchive = () => {
            closeId();
            isOpen = true;
            playClack();
            playRumble(2.5);
            modal.classList.remove('hidden');
            toggleBtn.classList.add('is-active');
            window.dispatchEvent(new CustomEvent('toggle-archive', { detail: { open: true } }));
            setHoverTarget('archive', true);
            
            // Trigger scramble on titles with slight delays
            setTimeout(() => {
                document.querySelectorAll('.col-title').forEach((el, index) => {
                    const finalStr = el.getAttribute('data-original') || el.innerText;
                    if (!el.hasAttribute('data-original')) el.setAttribute('data-original', finalStr);
                    setTimeout(() => {
                        runScramble(el, finalStr, 500);
                        playScramble(0.5);
                    }, index * 100);
                });
            }, 600); // Wait for boot animation delay
        };
        
        const closeArchive = () => {
            isOpen = false;
            playClack();
            playRumble(0.8);
            modal.classList.add('hidden');
            toggleBtn.classList.remove('is-active');
            window.dispatchEvent(new CustomEvent('toggle-archive', { detail: { open: false } }));
            setHoverTarget('archive', false);
            
            // Auto-collapse open items when closed
            setTimeout(() => {
                document.querySelectorAll('.project-item.is-expanded').forEach(item => {
                    item.classList.remove('is-expanded');
                    const btn = item.querySelector('.project-header');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                });
            }, 400);
        };

        toggleBtn.addEventListener('click', () => {
            if (isOpen) closeArchive();
            else openArchive();
        });
        
        toggleBtn.addEventListener('mouseenter', () => setHoverTarget('archive', true));
        toggleBtn.addEventListener('mouseleave', () => {
            if (!isOpen) setHoverTarget('archive', false);
        });

        closeBtn.addEventListener('click', closeArchive);

        // Category Accordions
        document.querySelectorAll('.category-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                playBlip();
                const section = btn.closest('.category-section');
                if (!section) return;
                const isExpanded = section.classList.contains('is-expanded');
                section.classList.toggle('is-expanded', !isExpanded);
                btn.setAttribute('aria-expanded', String(!isExpanded));
                const icon = btn.querySelector('.category-icon');
                if (icon) icon.textContent = isExpanded ? '+' : '-';
                
                // If closing the section, clear any active blueprint from the background
                if (isExpanded) {
                    window.dispatchEvent(new CustomEvent('project-hover', { detail: { url: null } }));
                    const archiveContent = document.querySelector('.archive-content');
                    if (archiveContent) archiveContent.classList.remove('blueprint-active');
                }
                
                // Scramble category title on click
                const titleEl = btn.querySelector('.category-title');
                if (titleEl) {
                    const finalStr = titleEl.getAttribute('data-original') || titleEl.innerText;
                    if (!titleEl.hasAttribute('data-original')) titleEl.setAttribute('data-original', finalStr);
                    runScramble(titleEl, finalStr, 300);
                }
            });
        });

        // Project Image Previews (hover – non-technologist items only)
        document.querySelectorAll('.project-item').forEach(item => {
            const section = item.closest('.category-section');
            const isTechnologist = section && section.querySelector('.category-title')?.textContent.includes('TECHNOLOGIST');
            if (isTechnologist) return; // handled by accordion click below

            item.addEventListener('mouseenter', () => {
                const url = item.getAttribute('data-image');
                if (url && isOpen) {
                    window.dispatchEvent(new CustomEvent('project-hover', { detail: { url, noEffects: false } }));
                }
            });
            item.addEventListener('mouseleave', () => {
                window.dispatchEvent(new CustomEvent('project-hover', { detail: { url: null } }));
            });
        });

        
        // 11 pieces available, 10 shown. `ar` = width / height of the artwork.
        const creativeArt = [
            { src: 'art-01.jpg', ar: 1000 / 1500 },
            { src: 'art-02.jpg', ar: 896 / 1200 },
            { src: 'art-03.jpg', ar: 3840 / 2560 },
            { src: 'art-04.jpg', ar: 2942 / 4160 },
            { src: 'art-05.jpg', ar: 2942 / 4160 },
            { src: 'art-06.jpg', ar: 4160 / 2942 },
            { src: 'art-07.jpg', ar: 2942 / 4160 },
            { src: 'art-08.jpg', ar: 2942 / 4160 },
            { src: 'art-09.jpg', ar: 2160 / 1440 },
            { src: 'art-10.jpg', ar: 2160 / 3840 },
            { src: 'art-11.jpg', ar: 2160 / 3840 }
        ];

        const initCreativeGrid = () => {
            const grid = document.getElementById('creative-grid');
            if (!grid) return;
            grid.innerHTML = '';

            // Fisher-Yates shuffle, then keep 10
            const pool = [...creativeArt];
            for (let i = pool.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [pool[i], pool[j]] = [pool[j], pool[i]];
            }

            pool.slice(0, 10).forEach(({ src, ar }, idx) => {
                const tile = document.createElement('div');
                tile.className = 'creative-item';
                tile.style.setProperty('--ar', ar.toFixed(4));

                const img = document.createElement('img');
                img.src = '/creative/thumbs/' + src;
                img.alt = 'Artwork ' + (idx + 1);
                img.loading = 'lazy';
                img.decoding = 'async';
                img.draggable = false;

                tile.appendChild(img);
                grid.appendChild(tile);
            });
        };
        initCreativeGrid();

        


        
        

        // Project Accordions
        document.querySelectorAll('.project-header').forEach(btn => {
            btn.addEventListener('click', () => {
                playDataPing();
                playClack(); // mechanical clack when slotting in
                const item = btn.closest('.project-item');
                if (!item) return;
                const isExpanded = item.classList.contains('is-expanded');
                
                // Auto-close other projects in the same list
                const parentList = item.closest('.project-list');
                if (parentList) {
                    parentList.querySelectorAll('.project-item.is-expanded').forEach(openItem => {
                        if (openItem !== item) {
                            openItem.classList.remove('is-expanded');
                            const openBtn = openItem.querySelector('.project-header');
                            if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
                        }
                    });
                    // Clear any active blueprint before showing the new one
                    window.dispatchEvent(new CustomEvent('project-hover', { detail: { url: null } }));
                    const ac = document.querySelector('.archive-content');
                    if (ac) ac.classList.remove('blueprint-active');
                }
                
                item.classList.toggle('is-expanded', !isExpanded);
                btn.setAttribute('aria-expanded', String(!isExpanded));

                // Show/hide technologist blueprint on expand/collapse
                const section = item.closest('.category-section');
                const isTechnologist = section && section.querySelector('.category-title')?.textContent.includes('TECHNOLOGIST');
                const archiveContent = document.querySelector('.archive-content');
                if (isTechnologist) {
                    if (!isExpanded) {
                        // Just expanded – show this project's blueprint + frost the modal
                        const url = item.getAttribute('data-image');
                        if (url) {
                            window.dispatchEvent(new CustomEvent('project-hover', { detail: { url, noEffects: true } }));
                        }
                        if (archiveContent) archiveContent.classList.add('blueprint-active');
                    } else {
                        // Just collapsed – clear the blueprint + remove frost
                        window.dispatchEvent(new CustomEvent('project-hover', { detail: { url: null } }));
                        if (archiveContent) archiveContent.classList.remove('blueprint-active');
                    }
                }
            });
        });
    }



</script>
