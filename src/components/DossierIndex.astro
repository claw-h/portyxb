---
// DossierIndex.astro
---

<div class="dossier-wrapper" id="dossier-wrapper">
    <!-- Mobile Gate Overlay (Visible only on mobile) -->
    <div id="mobile-gate">
        <div class="gate-content">
            <h2 class="gate-title">DESKTOP REQUIRED</h2>
            <p class="gate-text">This portfolio features heavy WebGL rendering and volumetric lighting designed strictly for a mouse and desktop GPU.</p>
            <div class="gate-separator"></div>
            <p class="gate-subtext">You can still browse my projects and contact me below.</p>
        </div>
    </div>

    <!-- 3D Canvas Placeholder -->
    <div class="canvas-placeholder">
        <canvas id="dossier-canvas"></canvas>
    </div>

    <!-- DOM UI Layer (DOM over Canvas) -->
    <div class="dom-overlay">
        <div id="id-frost" class="id-frost" data-no-matrix></div>

        <div id="id-card" class="id-card" data-no-matrix>
            <button id="id-toggle" class="id-face" aria-label="Open ID Card" aria-expanded="false">ID_CARD</button>
            <div class="id-body">
                <div class="id-header">
                    <span>ID // OPERATOR</span>
                    <button id="id-close" class="id-close" aria-label="Close ID Card">[X]</button>
                </div>
                <div class="id-main">
                    <div class="id-photo"><img src="/id/operator.jpg" alt="Operator Photo" /></div>
                    <div class="id-data">
                        <div class="id-row"><span class="id-label">NAME</span><span class="id-value">YASH BHARDWAJ</span></div>
                        <div class="id-row"><span class="id-label">CLASS</span><span class="id-value">CREATIVE TECHNOLOGIST</span></div>
                        <div class="id-row"><span class="id-label">HANDLE</span><span class="id-value">claw-h</span></div>
                        <div class="id-row"><span class="id-label">STATUS</span><span class="id-value id-status">ONLINE</span></div>
                    </div>
                </div>
                <div class="id-barcode"></div>
                <div class="id-actions">
                    <a href="mailto:contactATyxbDOTdirectory" onclick="this.href=this.href.replace(/AT/g,'@').replace(/DOT/g,'.')" class="id-action-btn"> [ INITIATE HANDSHAKE ]</a>
                    <a href="https://github.com/claw-h" target="_blank" rel="noopener" class="id-action-btn">[ ACCESS GITHUB ]</a>
                </div>
            </div>
        </div>

        <button id="archive-toggle" class="archive-btn" aria-label="Open Archive" data-no-matrix>ARCHIVE</button>


        <div id="archive-modal" class="archive-modal hidden" data-lenis-prevent="true">
            <!-- Modal Background: We will attach the shader here if needed or just use brutalist CSS -->
            <div class="archive-modal-bg"></div>
            
            <div class="archive-content">
                <div class="archive-header">
                    <h2 class="archive-title">INDEX // ARCHIVE</h2>
                    <button id="archive-close" class="archive-close" aria-label="Close Archive">[X]</button>
                </div>
                
                <div class="archive-lists">
                    
                    <!-- TECHNOLOGIST SECTION -->
                    <div class="category-section is-expanded">
                        <button class="category-toggle" aria-expanded="true">
                            <span class="category-title">TECHNOLOGIST // GITHUB</span>
                            <span class="category-icon">-</span>
                        </button>
                        <div class="category-content">
                            <div class="category-inner">
                                <div class="project-list">
                                    
                                    <div class="project-item" data-image="/blueprints/fuzzy-nav.png">
                                        <button class="project-header" aria-expanded="false">
                                            <div class="col-year">2026</div>
                                            <div class="col-title">fuzzy-nav</div>
                                            <div class="col-tech">Shell</div>
                                            <div class="col-icon">+</div>
                                        </button>
                                        <div class="project-details">
                                            <div class="project-details-inner">
                                                <div class="project-meta"><span>Domain:</span> Terminal Tooling // Core Nav</div>
                                                <div class="project-tag">Self-initiated R&D</div>
                                                <p class="project-desc">A blazingly fast fuzzy navigation utility designed to strip away the bloated overhead of traditional Zsh plugins. Engineered for sub-millisecond directory traversal and streamlined terminal workflows.</p>
                                                <a href="https://github.com/claw-h/fuzzy-nav" target="_blank" class="project-link" data-lens-target="archive">View Repository ↗</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="project-item" data-image="/blueprints/marketplace.png">
                                        <button class="project-header" aria-expanded="false">
                                            <div class="col-year">2026</div>
                                            <div class="col-title">marketplace</div>
                                            <div class="col-tech">TypeScript</div>
                                            <div class="col-icon">+</div>
                                        </button>
                                        <div class="project-details">
                                            <div class="project-details-inner">
                                                <div class="project-meta"><span>Domain:</span> Secure Platform Architecture</div>
                                                <div class="project-tag">Client project</div>
                                                <p class="project-desc">A highly secure, full-stack platform architecture built on Astro. Features a hardened, stateless OTP authentication pipeline, zero-trust session management, and a strictly typed Prisma ORM layer interacting with a PostgreSQL core. Engineered with strict CI/CD quality gates and production-ready security protocols.</p>
                                                <a href="https://github.com/claw-h/marketplace" target="_blank" class="project-link" data-lens-target="archive">View Repository ↗</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="project-item" data-image="/blueprints/schoolos.png">
                                        <button class="project-header" aria-expanded="false">
                                            <div class="col-year">2025</div>
                                            <div class="col-title">schoolos</div>
                                            <div class="col-tech">TypeScript</div>
                                            <div class="col-icon">+</div>
                                        </button>
                                        <div class="project-details">
                                            <div class="project-details-inner">
                                                <div class="project-meta"><span>Domain:</span> Education Tech</div>
                                                <div class="project-tag">Client project</div>
                                                <p class="project-desc">Educational Management Interface. Streamlining school operations, resource management, and grading systems.</p>
                                                <a href="https://github.com/claw-h/schoolos" target="_blank" class="project-link" data-lens-target="archive">View Repository ↗</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="project-item" data-image="/blueprints/loveos.png">
                                        <button class="project-header" aria-expanded="false">
                                            <div class="col-year">2025</div>
                                            <div class="col-title">loveOS (v2)</div>
                                            <div class="col-tech">
                                                <span>React, TSX, Framer Motion</span>
                                                <span class="featured-pill">FEATURED</span>
                                            </div>
                                            <div class="col-icon">+</div>
                                        </button>
                                        <div class="project-details">
                                            <div class="project-details-inner">
                                                <div class="project-meta"><span>Domain:</span> Realtime Sync App</div>
                                                <div class="project-tag">Self-initiated R&D</div>
                                                <div class="project-desc">
                                                    <p><span class="desc-heading">Problem.</span> A memory archive as a list or grid hides what connects things. I wanted to see the shape of a shared history, not scroll it.</p>
                                                    <p><span class="desc-heading">Decision.</span> Every tagged category becomes a constellation. Clusters sit on a golden-angle spiral so categories spread evenly across a sphere, and memories scatter inside each one as an elongated cloud. A minimum spanning tree draws the line figure, plus a couple of short cross-links so it reads like a star chart instead of a tree. Color tracks decay: gold for vivid memories, blue as they cool, ember as they fade. Positions are stable per memory, so a memory always lives in the same place.</p>
                                                    <p><span class="desc-heading">Build.</span> Custom 3D projection and depth sorting on Canvas 2D, no engine. New memories arrive in real time as a shooting star and a new node.</p>
                                                    <p><span class="desc-heading">Result.</span> 45+ fps at 3000+ nodes. Because the engine only needs a tag and a weight per point, the same system can map any categorized dataset.</p>
                                                </div>
                                                <a href="https://github.com/claw-h/loveOS" target="_blank" class="project-link" data-lens-target="archive">View Repository ↗</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="project-item" data-image="/blueprints/night.png">
                                        <button class="project-header" aria-expanded="false">
                                            <div class="col-year">2021</div>
                                            <div class="col-title">night</div>
                                            <div class="col-tech">Web</div>
                                            <div class="col-icon">+</div>
                                        </button>
                                        <div class="project-details">
                                            <div class="project-details-inner">
                                                <div class="project-meta"><span>Domain:</span> Cryptography / Puzzle</div>
                                                <div class="project-tag">Self-initiated R&D</div>
                                                <p class="project-desc">Personal ARG / cryptography puzzle engine designed for specialized interactive storytelling experiences.</p>
                                                <a href="https://github.com/claw-h/night" target="_blank" class="project-link" data-lens-target="archive">View Repository ↗</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="project-item" data-image="/blueprints/this-portfolio.png">
                                        <button class="project-header" aria-expanded="false">
                                            <div class="col-year">2026</div>
                                            <div class="col-title">This Portfolio</div>
                                            <div class="col-tech">Astro, WebGL, AI</div>
                                            <div class="col-icon">+</div>
                                        </button>
                                        <div class="project-details">
                                            <div class="project-details-inner">
                                                <div class="project-meta"><span>Domain:</span> Performance / WebGL</div>
                                                <div class="project-tag">Self-initiated R&D</div>
                                                <p class="project-desc">it speaks for itself</p>
                                                <div class="project-spec">WebGL · custom audio engine · 25+ fps on a 5-yr-old i3 · Lighthouse 93</div>
                                                <a href="https://github.com/claw-h/portyxb" target="_blank" class="project-link" data-lens-target="archive">View Source ↗</a>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CREATIVE SECTION (HMR FINAL) -->
                    <div class="category-section">
                        <button class="category-toggle" aria-expanded="false">
                            <span class="category-title">CREATIVE // STUDIO</span>
                            <span class="category-icon">+</span>
                        </button>
                        <div class="category-content">
                            <div class="category-inner">
                                <div id="creative-grid" class="creative-grid"></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dossier-wrapper {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        background: #020508;
    }

    .canvas-placeholder {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
    }

    #dossier-canvas {
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: auto;
    }

    .dom-overlay {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
        display: flex;
        flex-direction: column;
    }

    /* ─── Old Synth Skeuomorphic Button ─── */
    .archive-btn {
        position: absolute;
        bottom: 3rem;
        right: 3rem;
        width: 160px;
        height: 52px;
        pointer-events: auto;
        
        /* Matte dark plastic base */
        background: #1a1c23;
        color: #b0bac9;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        
        /* Physical mechanical bevels */
        border: 1px solid #080a0c;
        border-radius: 6px;
        box-shadow: 
            inset 0 2px 2px rgba(255, 255, 255, 0.1),   /* Top highlight */
            inset 0 -4px 4px rgba(0, 0, 0, 0.6),         /* Bottom bevel */
            inset 1px 0 2px rgba(255, 255, 255, 0.05),   /* Left highlight */
            inset -1px 0 2px rgba(0, 0, 0, 0.3),         /* Right shadow */
            0 8px 12px rgba(0, 0, 0, 0.8),               /* Drop shadow */
            0 15px 25px rgba(0, 0, 0, 0.6);              /* Ambient shadow */
            
        transition: all 0.1s cubic-bezier(0.4, 0.0, 0.2, 1);
        z-index: 50;
    }

    /* Synth LED Indicator */
    .archive-btn::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4a1f1f; /* Off state: dull dark red */
        box-shadow: 
            inset 0 2px 4px rgba(0,0,0,0.8),
            0 1px 0 rgba(255,255,255,0.1);
        transition: all 0.2s ease;
    }

    /* Active / Open state (Toggled by class) */
    .archive-btn.is-active::before {
        background: #ff3333; /* On state: glowing red */
        box-shadow: 
            inset 0 1px 2px rgba(255,255,255,0.6),
            0 0 8px #ff3333,
            0 0 15px #ff3333;
    }
    
    .archive-btn.is-active {
        color: #fff;
    }

    /* Mechanical Press */
    .archive-btn:active {
        transform: translateY(6px);
        box-shadow: 
            inset 0 1px 1px rgba(255, 255, 255, 0.05),
            inset 0 -2px 2px rgba(0, 0, 0, 0.6),
            0 2px 4px rgba(0, 0, 0, 0.8),
            0 4px 8px rgba(0, 0, 0, 0.6);
    }

    /* ─── ID CARD: button that expands into a mechanical card ─── */
    .id-frost {
        position: absolute;
        inset: 0;
        z-index: 5;
        background: rgba(4, 6, 10, 0.45);
        backdrop-filter: blur(14px) saturate(1.2);
        -webkit-backdrop-filter: blur(14px) saturate(1.2);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
    }
    .id-frost.is-active {
        opacity: 1;
        pointer-events: auto;
    }

    .id-card {
        /* Geometry: sits 1rem left of ARCHIVE (160px wide, 3rem from right).
           --cx = distance from viewport right edge to the button's center.
           Both states use right = --cx - width/2, so the center never moves
           and the bottom edge never moves: it grows up + out to both sides. */
        --closed-w: 160px;
        --closed-h: 52px;
        --open-w: 520px;
        --open-h: 420px;
        --cx: calc(3rem + 160px + 1rem + var(--closed-w) / 2);

        position: absolute;
        right: calc(var(--cx) - var(--closed-w) / 2);
        bottom: 3rem;
        width: var(--closed-w);
        height: var(--closed-h);
        pointer-events: auto;
        z-index: 60;
        overflow: hidden;

        background: #1a1c23;
        border: 1px solid #080a0c;
        border-radius: 6px;
        box-shadow:
            inset 0 2px 2px rgba(255, 255, 255, 0.1),
            inset 0 -4px 4px rgba(0, 0, 0, 0.6),
            0 8px 12px rgba(0, 0, 0, 0.8),
            0 15px 25px rgba(0, 0, 0, 0.6);

        transition:
            right 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            height 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            border-radius 0.6s ease,
            border-color 0.3s ease;
    }

    .id-card.is-open {
        right: calc(var(--cx) - var(--open-w) / 2);
        width: var(--open-w);
        height: min(var(--open-h), calc(100% - 6rem));
        border-radius: 10px;
        border-color: rgba(255, 51, 51, 0.5);
    }

    /* The closed-state button face (same look as ARCHIVE) */
    .id-face {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: transparent;
        border: none;
        color: #b0bac9;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        cursor: pointer;
        transition: opacity 0.25s ease, color 0.2s ease;
    }
    .id-face:hover { color: #fff; }
    .id-face::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4a1f1f;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.8), 0 1px 0 rgba(255,255,255,0.1);
    }
    .id-card.is-open .id-face {
        opacity: 0;
        pointer-events: none;
    }

    /* The card contents: fixed layout, fades in once the shell is mostly open */
    .id-body {
        position: absolute;
        inset: 0;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        color: #b0bac9;
        font-family: 'IBM Plex Mono', monospace;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
    }
    .id-card.is-open .id-body {
        opacity: 1;
        pointer-events: auto;
        transition: opacity 0.4s ease 0.35s;
    }

    /* Lanyard slot + hazard strip */
    .id-body::before {
        content: '';
        position: absolute;
        top: 10px;
        left: 50%;
        width: 56px;
        height: 8px;
        transform: translateX(-50%);
        border-radius: 4px;
        background: #040507;
        box-shadow: inset 0 2px 3px rgba(0,0,0,0.9), 0 1px 0 rgba(255,255,255,0.08);
    }
    .id-body::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 5px;
        background: repeating-linear-gradient(
            45deg,
            rgba(0,0,0,0.8), rgba(0,0,0,0.8) 6px,
            rgba(255,170,0,0.6) 6px, rgba(255,170,0,0.6) 12px
        );
        opacity: 0.6;
    }

    .id-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        font-size: 0.7rem;
        letter-spacing: 0.25em;
        color: #72849c;
    }
    .id-close {
        background: none;
        border: none;
        color: #72849c;
        font-family: inherit;
        font-size: 0.85rem;
        cursor: pointer;
        transition: color 0.2s;
    }
    .id-close:hover { color: #ff3333; }

    .id-main {
        display: flex;
        gap: 1.5rem;
        flex: 1;
        min-height: 0;
    }
    .id-photo {
        flex: none;
        width: 140px;
        height: 180px;
        position: relative;
        overflow: hidden;
        background: #040507;
        border: 1px solid #000;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.9), 0 0 0 1px rgba(143,220,255,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(143,220,255,0.25);
        font-size: 0.6rem;
        letter-spacing: 0.2em;
    }
    .id-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: relative;
        z-index: 1;
        filter: grayscale(80%) sepia(20%) hue-rotate(180deg) contrast(1.1) brightness(0.9);
        mix-blend-mode: hard-light;
        opacity: 0.85;
    }
    .id-photo::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: repeating-linear-gradient(
            0deg, rgba(255,255,255,0.03), rgba(255,255,255,0.03) 1px, transparent 1px, transparent 3px
        );
    }
    .id-data {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        min-width: 0;
    }
    .id-row { display: flex; flex-direction: column; gap: 2px; }
    .id-label { font-size: 0.55rem; letter-spacing: 0.2em; color: #72849c; }
    .id-value { font-size: 0.9rem; font-weight: 600; color: #fff; }
    .id-value.id-status {
        color: #ff3333;
        text-shadow: 0 0 8px rgba(255,51,51,0.4);
    }

    .id-barcode {
        height: 26px;
        opacity: 0.55;
        background: repeating-linear-gradient(
            90deg,
            #b0bac9 0 2px, transparent 2px 4px,
            #b0bac9 4px 5px, transparent 5px 9px,
            #b0bac9 9px 12px, transparent 12px 14px
        );
    }
    .id-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; padding-bottom: 0.5rem; }
    .id-action-btn {
        flex: 1;
        min-width: 140px;
        text-align: center;
        padding: 0.7rem 0.5rem;
        background: #1a1c23;
        border: 1px solid #080a0c;
        border-radius: 4px;
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.08), inset 0 -2px 2px rgba(0,0,0,0.6);
        color: #b0bac9;
        font-size: 0.65rem;
        letter-spacing: 0.15em;
        text-decoration: none;
        transition: color 0.2s, transform 0.1s;
    }
    .id-action-btn:hover { color: #ffaa00; }
    .id-action-btn:active { transform: translateY(2px); }

    /* ─── Transparent Reveal Modal ─── */
    .archive-modal {
        will-change: opacity, visibility;
        transform: translateZ(0);
        position: absolute;
        inset: 0;
        pointer-events: none;
        display: flex;
        align-items: flex-start; /* Changed from center to prevent top clipping */
        justify-content: center;
        padding: 4rem 2rem; /* Added more top/bottom padding for scroll space */
        transition: opacity 0.4s ease, visibility 0.4s ease;
        z-index: 20;
        overflow-y: auto;
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }
    .archive-modal::-webkit-scrollbar {
        display: none;
    }

    
    .archive-modal:not(.hidden) {
        pointer-events: auto;
    }

    .archive-modal.hidden {
        opacity: 0;
        visibility: hidden;
    }

    .archive-modal-bg { /* transparent */ }

    .archive-content {
        margin: auto; /* Centers the content safely without top-clipping when overflowing */
        will-change: transform, opacity;
        transform-style: preserve-3d;
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1000px;
        color: #b0bac9; 
        font-family: 'IBM Plex Mono', 'SFMono-Regular', monospace;
        padding: 2rem;
        pointer-events: auto;
        
        transform: translateY(30px) scale(0.98);
        opacity: 0;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: 0s;
    }
    
    .archive-modal:not(.hidden) .archive-content {
        transform: translateY(0) scale(1);
        opacity: 1;
        transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: 0.2s;
    }

    /* Frosted glass when a technologist blueprint is active behind the modal */
    .archive-content.blueprint-active {
        background: rgba(4, 6, 10, 0.4);
        backdrop-filter: blur(16px) saturate(1.3);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        border: 1px solid rgba(143, 220, 255, 0.08);
        border-radius: 8px;
    }

    .archive-content.blueprint-active .archive-header {
        background: rgba(22, 24, 29, 0.4);
    }

    .archive-content.blueprint-active .category-section {
        background: rgba(22, 24, 29, 0.25);
    }

    .archive-content.blueprint-active .project-item {
        background: rgba(22, 24, 29, 0.15);
    }

    .archive-content.blueprint-active .project-item.is-expanded {
        background: rgba(26, 28, 35, 0.35);
    }

    .archive-content.blueprint-active .project-details {
